{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|NotebookEdit|MultiEdit|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gatekeeper_hook.py"],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gatekeeper_hook.py"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
